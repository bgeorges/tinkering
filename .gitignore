# Root ignore rules shared by every sub-project.
# Sub-projects may add their own .gitignore for stack-specific rules.
#
# Note: there is deliberately NO `lib/` rule here. MicroPython projects
# (tracker/) keep board libraries in lib/ and they must be
# committed.

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Python / MicroPython ---
__pycache__/
*.py[cod]
*.mpy
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Node (relay-controller/) ---
node_modules/
npm-debug.log*

# --- Arduino (bsd/) ---
build/
*.hex
*.elf
*.bin

# --- Logs ---
*.log
